<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="5.0">
    <listener>
        <listener-class>app.web.AppInit</listener-class>
    </listener>

    <servlet>
        <servlet-name>comments</servlet-name>
        <servlet-class>app.web.CommentsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>comments</servlet-name>
        <url-pattern>/comments</url-pattern>
    </servlet-mapping>
</web-app>
